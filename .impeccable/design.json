      "html": "<button class=\"ds-tile\"><span class=\"ds-glyph\">Σ</span><span class=\"ds-done\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z\"/></svg></span><span class=\"ds-no\">№ 9</span></button>",
      "css": ".ds-tile{position:relative;width:120px;height:120px;border:none;border-radius:16px;background:#fff;box-shadow:inset 0 0 0 1px #0f2a3d33;cursor:pointer;font-family:Manrope,Roboto,sans-serif}.ds-tile:focus-visible{outline:2px solid #2a7590;outline-offset:3px}.ds-tile:active{transform:scale(.96)}.ds-glyph{position:absolute;inset:0 0 24px;display:grid;place-items:center;color:#1f5d80;font-size:34px;font-weight:800}.ds-done{position:absolute;top:6px;right:6px;width:28px;height:28px;border-radius:50%;background:#2a7590;color:#fff;display:grid;place-items:center}.ds-no{position:absolute;left:6px;bottom:6px;padding:3px 8px;border-radius:99px;background:#fff;color:#0f2a3d;font-size:13px;font-weight:800;box-shadow:inset 0 0 0 1px #0f2a3d1f}"
    },
