      "css": ".ds-opt{display:inline-flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;width:72px;min-height:92px;border:none;border-radius:16px;background:#ffffffb3;box-shadow:inset 0 0 0 1px #0f2a3d33;color:#0f2a3d;font:800 22px Manrope,Roboto,sans-serif;cursor:pointer;transition:box-shadow .15s,transform .15s}.ds-opt:hover,.ds-opt:focus-visible{box-shadow:inset 0 0 0 3px #2a7590;outline:none}.ds-opt:active{transform:scale(.97)}.ds-let{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:#cdebee;color:#1f5d80;font-size:14px}"
    },
    {
      "name": "Difficulty Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Сложность звёздами, баллы — тихой подписью.",
      "html": "<span class=\"ds-chip\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"#1f5d80\"><path d=\"M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z\"/></svg><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"#1f5d80\"><path d=\"M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z\"/></svg><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"#1f5d80\"><path d=\"M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z\"/></svg><span>5 баллов</span></span>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:2px;padding:5px 11px 5px 8px;border-radius:99px;background:#fff;color:#0f2a3d;font:800 13px Manrope,Roboto,sans-serif;box-shadow:inset 0 0 0 1px #0f2a3d1f}.ds-chip span{margin-left:4px}"
