      "html": "<div class=\"ds-bar\"><button class=\"ds-back\" aria-label=\"Назад\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M20 11H7.8l5.6-5.6L12 4l-8 8 8 8 1.4-1.4L7.8 13H20z\"/></svg></button><b>Задача 24</b><span class=\"ds-tries\"><i></i><i></i><i class=\"u\"></i></span></div>",
      "css": ".ds-bar{display:flex;align-items:center;gap:4px;width:340px;height:56px;padding:0 8px 0 4px;background:#e9f7f7;color:#0f2a3d;font-family:Manrope,Roboto,sans-serif}.ds-bar b{flex:1;font-size:22px;font-weight:800;letter-spacing:-.02em}.ds-back{width:48px;height:48px;border:none;border-radius:50%;background:none;color:inherit;display:grid;place-items:center;cursor:pointer}.ds-back:hover{background:#0f2a3d0d}.ds-back:focus-visible{outline:2px solid #2a7590}.ds-tries{display:flex;gap:6px}.ds-tries i{width:12px;height:12px;border-radius:50%;background:#2a7590}.ds-tries i.u{background:none;box-shadow:inset 0 0 0 2px #0f2a3d47}"
    }
