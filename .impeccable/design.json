      "html": "<button class=\"ds-btn-sec\">Показать все 33</button>",
      "css": ".ds-btn-sec{height:48px;padding:0 20px;border:none;border-radius:24px;background:#ffffffb3;box-shadow:inset 0 0 0 1.5px #0f2a3d33;color:#0f2a3d;font:700 15px Manrope,Roboto,sans-serif;cursor:pointer}.ds-btn-sec:active{transform:scale(.98)}.ds-btn-sec:focus-visible{outline:2px solid #2a7590;outline-offset:3px}"
