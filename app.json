{
  "expo": {
    "name": "MathOlymp",
    "slug": "math-olymp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "matholymp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.kondrse.matholymp"
    },
    "android": {
      "package": "com.kondrse.matholymp",
      "adaptiveIcon": {
        "backgroundColor": "#e9f7f7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#e9f7f7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 192
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "08be3f27-cbdf-423c-8cae-41d72046987b"
      }
    }
  }
}
